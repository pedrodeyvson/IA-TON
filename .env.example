SUPABASE_URL=
# Chave publicável, usada pela sessão do operador (login do CRM).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_SITE_URL=
UAZAPI_BASE_URL=
UAZAPI_TOKEN=
UAZAPI_WEBHOOK_SECRET=
# Transcricao de audio (Groq Whisper)
GROQ_API_KEY=

# Agente de IA (Fatia 2) e embeddings da base de conhecimento (Fatia 3)
OPENAI_API_KEY=
# Modelo usado pelo agente para conversar com o lead.
OPENAI_MODEL=gpt-5.4-mini
# Identificador de indicação usado para montar o link de checkout/catálogo da
# Ton. Sem essa variável, montarLink falha fechado: a Mika escala todo lead
# que chega no ponto de mandar o link, em vez de mandar.
TON_REFERRER=
# Liga/desliga o agente sem precisar tirar o worker do ar (padrão: true).
AGENTE_ATIVO=true
# Debounce, em milissegundos, entre a última mensagem do lead e o agente responder.
AGENTE_DEBOUNCE_MS=8000
# Comissão padrão, em reais, usada quando o lead converte sem valor específico registrado.
COMISSAO_PADRAO_BRL=

# Meta Conversions API (CAPI) — envio de eventos de conversão (LeadSubmitted,
# QualifiedLead, InitiateCheckout, Purchase) via WhatsApp/business_messaging.
# Opcional: sem essas duas variáveis o envio degrada em silêncio (skipped),
# o sistema funciona normalmente sem CAPI configurado.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Opcional: test_event_code do Pixel, só para depuração em modo de teste.
META_CAPI_TEST_CODE=
